# Copy to .env and fill in what you have. EVERYTHING is optional — with no
# values set, CreditLoop runs fully on mocks + synthetic-truth.

# --- The company CreditLoop judges claims for -----------------------------
CREDITLOOP_COMPANY_NAME=Acme India Pvt Ltd
CREDITLOOP_COMPANY_GSTIN=29AABCA1234A1Z5
CREDITLOOP_COMPANY_STATE_CODE=29

# --- AI: Google Gemini (free-tier vision). THIS is the one key that matters.
# Get it free at https://aistudio.google.com/apikey . With it set, receipts are
# read by a real vision model, and vendor requests + rule proposals are AI-drafted.
CREDITLOOP_GEMINI_API_KEY=
CREDITLOOP_GEMINI_MODEL=gemini-flash-latest
CREDITLOOP_LLM_EXTRACT_SAMPLE=24

# --- RazorpayX payouts (OPTIONAL — leave blank to use safe mock payouts) ---
# Only needed if you want real test-mode payout API calls. Requires a RazorpayX
# test account with a fund account configured.
CREDITLOOP_RAZORPAY_KEY_ID=
CREDITLOOP_RAZORPAY_KEY_SECRET=
CREDITLOOP_RAZORPAY_FUND_ACCOUNT=
CREDITLOOP_RAZORPAY_ACCOUNT_NUMBER=
